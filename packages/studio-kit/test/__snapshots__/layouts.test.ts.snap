exports[`layouts build headless > roll: zero errors, explain snapshot 1`] = `
"shell "Chromobench" · theme craftkit · kits: cb.core@1, cb.stack@1 (requires cb.core), cb.diagnostics@1 (requires cb.core), cb.select@1 (requires cb.core), cb.roll@1 (requires cb.core)
module roll "Roll" key G
  left   dockcol  width 300
           panel roll-library "Rolls"
             roll.library
           panel first-print-roll "First print"
             slider 0…100 "Neutralise"  bind prefs.neutralise  decimals 0  reset 75  step 5  tip "How much of each frame’s colour cast a first p…  unit "%"
             text "How much of each frame’s colour cast a first p…  dim  wrap
             button  run print.firstPrint  small  text "First print again"
           panel roll-setup "Roll setup"
             roll.setup
  center column  class "cb-roll-sheet"  grow 1
           row  class "cb-roll-sheet-bar"
             segmented "Contact sheet"  bind rollView.contact.mode  options [{…}, {…}]  small
             roll.progress
           gridview contact  cell θ  empty "No roll yet: open the scans, then Roll ▸ New R…  items τ  key θ  select ui.selection  size τ
  right  dockcol  width 320
           panel roll-balance "Print the roll like…"
             roll.balanceBar
           panel roll-inspector "Roll analysis"
             roll.inspector
           panel history-roll "History"
             cb.history
module print "Print" key D stages darkroom
  left   dockcol  width 236
           panel navigator-print "Navigator"
             thumb  image τ
             text τ  dim
           panel snapshots "Snapshots"
             cb.snapshots
           panel history "History"
             cb.history
  center column  class "cb-viewer"  grow 1
           segmented "View"  bind view.view  options [{…}, {…}, {…}, {…}]  small
           cb.ribbon
           match  of [view, ring]  on τ
             cases.view:
               viewport main τ  before τ  compare  cover τ  image τ  overlays:   tools [probe, test-strip, mask-linear, mask-radial, m…
                 hud:
                   cb.readout
             cases.ring:
               column  class "cb-ring"  grow 1
                 text "Ring-around, 4 pt: click the print that looks …  strong
                 grid  class "cb-ring-grid"  cols 3
                   column  class "cb-ring-tile"
                     thumb  image τ
                     button "+Y (−B)"  run ring.apply([-0.05, -0.05, …, "Ring-around +Y…)  small
                   column  class "cb-ring-tile"
                     thumb  image τ
                     button "+R (−C)"  run ring.apply([-0.1, 0.05, 0.…, "Ring-around +R…)  small
                   column  class "cb-ring-tile"
                     thumb  image τ
                     button "+M (−G)"  run ring.apply([-0.05, 0.1, -0…, "Ring-around +M…)  small
                   column  class "cb-ring-tile"
                     thumb  image τ
                     button "+G (−M)"  run ring.apply([0.05, -0.1, 0.…, "Ring-around +G…)  small
                   column  class "cb-ring-tile is-current"
                     thumb  image τ
                     button  run tool.none  small  text "Keep this one"
                   column  class "cb-ring-tile"
                     thumb  image τ
                     button "+B (−Y)"  run ring.apply([0.05, 0.05, -0…, "Ring-around +B…)  small
                   spacer
                   column  class "cb-ring-tile"
                     thumb  image τ
                     button "+C (−R)"  run ring.apply([0.1, -0.05, -0…, "Ring-around +C…)  small
                   spacer
                 row  class "cb-ring-density"
                   column  class "cb-ring-tile"
                     thumb  image τ
                     button "−2 step"  run ring.apply([-0.2, -0.2, -0…, "Ring-around −2…)  small
                   column  class "cb-ring-tile"
                     thumb  image τ
                     button "−1 step"  run ring.apply([-0.1, -0.1, -0…, "Ring-around −1…)  small
                   column  class "cb-ring-tile"
                     thumb  image τ
                     button "+1 step"  run ring.apply([0.1, 0.1, 0.1], "Ring-around +1…)  small
                   column  class "cb-ring-tile"
                     thumb  image τ
                     button "+2 step"  run ring.apply([0.2, 0.2, 0.2], "Ring-around +2…)  small
  right  dockcol  width 300
           panel tools "Tools"
             row  class "cb-tools"
               button  run tool.probe  small  text "Densitometer"
               button  run tool.test-strip  small  text "Test strip"
               button  run tool.ring-around  small  text "Ring-around"
               button  run view.beforeAfter  small  text "Before / after"
           panel densitometer "Densitometer"
             cb.densitometer
           panel controls-darkroom "Darkroom"
             when  cond τ
               else:
                 text "Select a photo to print it."  dim  wrap
               then:
                 column
                   section "Exposure"
                     cb.arg  path "stages.darkroom.medium.mode"  rollScope "frame"  segmented
                     cb.arg  path "main.params.time_s"  rollScope "frame"  slider  s  log2  step 1/6 st  aside st
                     cb.arg  path "main.params.fstop"  rollScope "frame"  stepper  f  log2  aside st
                     text τ  dim  wrap
                   section "Filtration"
                     cb.arg  path "main.params.filtration"  rollScope "frame"  slider  CC  step 1 CC  aside pt  detent 0
                   section "Printer lights"
                     cb.arg  path "lights.params.logH"  rollScope "frame"  widget "pad"  pad  pt  step 1 pt  aside log H  detent 0
                   section "Paper"
                     cb.arg  path "stages.darkroom.medium.paper"  rollScope "frame"  select
                     cb.arg  path "stages.darkroom.medium.grade"  rollScope "frame"  slider  step 0.5 none
                   section "Film and viewing"
                     cb.arg  path "stages.film.medium.stock"  rollScope "frame"  select
                     cb.arg  path "stages.scan.medium.stock"  rollScope "frame"  select
                     cb.arg  path "stages.scan.medium.scanner"  rollScope "frame"  select
                     cb.arg  path "stages.print.medium.illuminant"  rollScope "frame"  select
                     text τ  dim  wrap
           panel first-print "First print"
             slider 0…100 "Neutralise"  bind prefs.neutralise  decimals 0  reset 75  step 5  tip "How much of each frame’s colour cast a first p…  unit "%"
             text "How much of each frame’s colour cast a first p…  dim  wrap
             button  run print.firstPrint  small  text "First print again"
           panel exposures "Exposures"
             stack.layers  stage "darkroom"  light law · + Layer 6 ops
             text τ  class "cb-script"  dim  wrap
           panel layer-params-print "Layer"
             stack.params  editors {curve, levels, hsl, grade, mixer}
           panel layer-masks-print "Mask"
             stack.masks
           panel approvals "Agent proposals"
             cb.approvals
  bottom dockcol  width 124
           filmstrip strip-print  cell θ  context [frame.reopenAsPhoto, frame.reopenAsNegative, -…  empty "No photos yet: File ▸ Open Files… (Ctrl+O), or…  items τ  key θ  keys {Delete, Backspace}  select ui.selection
