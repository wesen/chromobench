module lab "Lab" key L stages darkroom
  left   dockcol  width 280
           panel controls-all "All parameters"
             when  cond τ
               else:
                 text "Select a photo to print it."  dim  wrap
               then:
                 column
                   section "Enlarger"
                     cb.arg  path "main.params.time_s"  slider  s  log2  step 1/6 st  aside st
                     cb.arg  path "main.params.fstop"  stepper  f  log2  aside st
                     cb.arg  path "main.params.filtration"  slider  CC  step 1 CC  aside pt  detent 0
                   section "Printer lights"
                     cb.arg  path "lights.params.logH"  widget "pad"  pad  pt  step 1 pt  aside log H  detent 0
                   section "Scan"
                     cb.arg  path "stages.scan.medium.scanner"  select
                     cb.arg  path "stages.scan.medium.stock"  select
                     cb.arg  path "stages.scan.medium.flare"  slider  percent  step 0.05 percent
                   section "Capture"
                     cb.arg  path "stages.scene.medium.whiteBalance.mode"  segmented
                     cb.arg  path "stages.scene.medium.whiteBalance.temperature_K"  slider  K  step 50 K
                     cb.arg  path "stages.scene.medium.whiteBalance.tint"  slider  step 1 none
                     cb.arg  path "stages.film.medium.stock"  select
                     cb.arg  path "stages.film.medium.exposureEV"  slider  st  step 0.333 st
                   section "Film"
                     cb.arg  path "stages.film.medium.push"  stepper  st  step 1 st
                     cb.arg  path "stages.film.medium.dir.amount"  slider  fraction  step 0.05 fraction
                     cb.arg  path "stages.film.medium.dir.diffusion_um"  slider  um  step 1 um
                     cb.arg  path "stages.film.medium.halation.strength"  slider  fraction  step 0.05 fraction
                     cb.arg  path "stages.film.medium.grain.amount"  slider  fraction  step 0.05 fraction
                     cb.arg  path "stages.film.medium.grain.size_um"  slider  um  step 0.5 um
                   section "Print"
                     cb.arg  path "stages.darkroom.medium.paper"  select
