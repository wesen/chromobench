                     thumb  image τ
                     button "+2 step"  run ring.apply([0.2, 0.2, 0.2], "Ring-around +2…)  small
  right  dockcol  width 300
           panel enlarger "Enlarger"
             stack.layers  order "choice"  row θ  stage "darkroom"  light law · + Layer 6 ops
           panel paper "Paper"  hidden τ
             when  cond τ
               else:
                 text "Select a photo to print it."  dim  wrap
               then:
                 column
                   cb.arg  path "stages.darkroom.medium.paper"  select
                   cb.arg  path "stages.darkroom.medium.grade"  slider  step 0.5 none
           panel digital "Digital (after the print)"  hidden τ
             stack.layers  density "compact"  stage "print"  composite law · + Layer 10 ops
           panel layer-params "Layer"  hidden τ
             stack.params  editors {curve, levels, hsl, grade, mixer}
           panel layer-masks "Mask"  hidden τ
             stack.masks
           panel approvals "Agent proposals"  hidden τ
