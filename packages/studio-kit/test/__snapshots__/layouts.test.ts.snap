exports[`layouts build headless > finish: zero errors, explain snapshot 1`] = `
"shell "Chromobench" · theme craftkit · kits: cb.core@1, cb.stack@1 (requires cb.core), cb.diagnostics@1 (requires cb.core), cb.select@1 (requires cb.core), cb.finish@1 (requires cb.core)
module library "Library" key G
  left   dockcol  width 236
           panel navigator "Navigator"
             thumb  image τ
             text τ  dim
           panel library "Library"
             cb.library
  center column  grow 1
           cb.filter
           match  of [grid, loupe, compare, survey]  on τ
             cases.grid:
               gridview grid  cell θ  context [frame.reopenAsPhoto, frame.reopenAsNegative, -…  empty "No photos yet: File ▸ Open Files… (Ctrl+O), or…  items τ  key θ  keys {Delete, Backspace}  select ui.selection  size τ
             cases.loupe:
               column  class "cb-viewer"  grow 1
                 cb.ribbon
                 viewport loupe τ  cover τ  image τ  overlays: 
             cases.compare:
               row  grow 1
                 column  class "cb-viewer"  grow 1
                   cb.ribbon
                   viewport cmp-a τ  cover τ  image τ  overlays: 
                 column  class "cb-viewer"  grow 1
                   cb.ribbon
                   viewport cmp-b τ  cover τ  image τ  overlays: 
             cases.survey:
               gridview survey  cell θ  context [frame.reopenAsPhoto, frame.reopenAsNegative, -…  empty "No photos yet: File ▸ Open Files… (Ctrl+O), or…  items τ  key θ  keys {Delete, Backspace}  select ui.selection  size τ
  right  dockcol  width 260
           panel metadata "Metadata"
             cb.metadata
  bottom dockcol  width 124
           filmstrip strip  cell θ  context [frame.reopenAsPhoto, frame.reopenAsNegative, -…  empty "No photos yet: File ▸ Open Files… (Ctrl+O), or…  items τ  key θ  keys {Delete, Backspace}  select ui.selection
module print "Print" key D stages darkroom
  left   dockcol  width 236
           panel navigator-print "Navigator"
             thumb  image τ
             text τ  dim
           panel snapshots "Snapshots"
             cb.snapshots
           panel history "History"
             cb.history
  center column  class "cb-viewer"  grow 1
           segmented "View"  bind view.view  options [{…}, {…}, {…}, {…}]  small
           cb.ribbon
           match  of [view, ring]  on τ
             cases.view:
               viewport main τ  before τ  compare  cover τ  image τ  overlays:   tools [probe, test-strip, mask-linear, mask-radial, m…
                 hud:
                   cb.readout
             cases.ring:
               column  class "cb-ring"  grow 1
                 text "Ring-around, 4 pt: click the print that looks …  strong
                 grid  class "cb-ring-grid"  cols 3
                   column  class "cb-ring-tile"
                     thumb  image τ
                     button "+Y (−B)"  run ring.apply([-0.05, -0.05, …, "Ring-around +Y…)  small
                   column  class "cb-ring-tile"
                     thumb  image τ
                     button "+R (−C)"  run ring.apply([-0.1, 0.05, 0.…, "Ring-around +R…)  small
                   column  class "cb-ring-tile"
                     thumb  image τ
                     button "+M (−G)"  run ring.apply([-0.05, 0.1, -0…, "Ring-around +M…)  small
                   column  class "cb-ring-tile"
                     thumb  image τ
                     button "+G (−M)"  run ring.apply([0.05, -0.1, 0.…, "Ring-around +G…)  small
                   column  class "cb-ring-tile is-current"
                     thumb  image τ
                     button  run tool.none  small  text "Keep this one"
                   column  class "cb-ring-tile"
                     thumb  image τ
                     button "+B (−Y)"  run ring.apply([0.05, 0.05, -0…, "Ring-around +B…)  small
                   spacer
                   column  class "cb-ring-tile"
                     thumb  image τ
                     button "+C (−R)"  run ring.apply([0.1, -0.05, -0…, "Ring-around +C…)  small
                   spacer
                 row  class "cb-ring-density"
                   column  class "cb-ring-tile"
                     thumb  image τ
                     button "−2 step"  run ring.apply([-0.2, -0.2, -0…, "Ring-around −2…)  small
                   column  class "cb-ring-tile"
                     thumb  image τ
                     button "−1 step"  run ring.apply([-0.1, -0.1, -0…, "Ring-around −1…)  small
                   column  class "cb-ring-tile"
                     thumb  image τ
                     button "+1 step"  run ring.apply([0.1, 0.1, 0.1], "Ring-around +1…)  small
                   column  class "cb-ring-tile"
                     thumb  image τ
                     button "+2 step"  run ring.apply([0.2, 0.2, 0.2], "Ring-around +2…)  small
  right  dockcol  width 300
           panel tools "Tools"
             row  class "cb-tools"
               button  run tool.probe  small  text "Densitometer"
               button  run tool.test-strip  small  text "Test strip"
               button  run tool.ring-around  small  text "Ring-around"
               button  run view.beforeAfter  small  text "Before / after"
           panel densitometer "Densitometer"
             cb.densitometer
           panel controls-darkroom "Darkroom"
             when  cond τ
               else:
                 text "Select a photo to print it."  dim  wrap
               then:
                 column
                   section "Exposure"
                     cb.arg  path "stages.darkroom.medium.mode"  segmented
                     cb.arg  path "main.params.time_s"  slider  s  log2  step 1/6 st  aside st
                     cb.arg  path "main.params.fstop"  stepper  f  log2  aside st
                     text τ  dim  wrap
                   section "Filtration"
                     cb.arg  path "main.params.filtration"  slider  CC  step 1 CC  aside pt  detent 0
                   section "Printer lights"
                     cb.arg  path "lights.params.logH"  widget "pad"  pad  pt  step 1 pt  aside log H  detent 0
                   section "Paper"
                     cb.arg  path "stages.darkroom.medium.paper"  select
                     cb.arg  path "stages.darkroom.medium.grade"  slider  step 0.5 none
                   section "Film and viewing"
                     cb.arg  path "stages.film.medium.stock"  select
                     cb.arg  path "stages.scan.medium.stock"  select
                     cb.arg  path "stages.scan.medium.scanner"  select
                     cb.arg  path "stages.print.medium.illuminant"  select
                     text τ  dim  wrap
           panel first-print "First print"
             slider 0…100 "Neutralise"  bind prefs.neutralise  decimals 0  reset 75  step 5  tip "How much of each frame’s colour cast a first p…  unit "%"
             text "How much of each frame’s colour cast a first p…  dim  wrap
             button  run print.firstPrint  small  text "First print again"
           panel exposures "Exposures"
             stack.layers  stage "darkroom"  light law · + Layer 6 ops
             text τ  class "cb-script"  dim  wrap
           panel layer-params-print "Layer"
             stack.params  editors {curve, levels, hsl, grade, mixer}
           panel layer-masks-print "Mask"
             stack.masks
           panel approvals "Agent proposals"
             cb.approvals
  bottom dockcol  width 124
           filmstrip strip-print  cell θ  context [frame.reopenAsPhoto, frame.reopenAsNegative, -…  empty "No photos yet: File ▸ Open Files… (Ctrl+O), or…  items τ  key θ  keys {Delete, Backspace}  select ui.selection
module finish "Finish" key F stages scan, print
  left   dockcol  width 236
           panel navigator-finish "Navigator"
             thumb  image τ
             text τ  dim
           panel history-finish "History"
             cb.history
  center column  class "cb-viewer"  grow 1
           cb.ribbon
           viewport finish τ  before τ  compare  cover τ  image τ  overlays:   tools [crop, spot]
             hud:
               cb.readout
  right  dockcol  width 300
           panel finish-crop "Crop & straighten"
             row  class "cb-finish-tools"
               button  run tool.crop  small  text "Crop (R)"
               button  run crop.done  small  text "Done"
             select "Aspect"  bind finish.crop.aspect  options [{…}, {…}, {…}, {…}, {…}, {…}, {…}, {…}, {…}, {…  set crop.aspect
             checkbox "Lock aspect"  bind finish.crop.locked  switch
             text τ  class "cb-crop-readout"  dim
             row  class "cb-finish-angle"
               button "−1°"  run crop.straighten(-1)  small
               button "−0.1°"  run crop.straighten(-0.1)  small
               button "0°"  run crop.straighten({to})  small
               button "+0.1°"  run crop.straighten(0.1)  small
               button "+1°"  run crop.straighten(1)  small
             row  class "cb-finish-orient"
               button  run orient.ccw  small  text "⟲"
               button  run orient.cw  small  text "⟳"
               button  run orient.flipH  small  text "⇋"
               button  run orient.flipV  small  text "⇵"
               button  run crop.swap  small  text "Swap"
               button  run crop.reset  small  text "Reset"
             text τ  class "cb-warn"
           panel finish-retouch "Spot removal"
             row  class "cb-finish-tools"
               button  run tool.spot  small  text "Spots (Q)"
               button  run spot.show  small  text "Show"
             segmented "Mode"  bind finish.spot.mode  options [{…}, {…}, {…}]  small
             slider 1…200 "Size"  bind finish.spot.r  decimals 0  step 1  unit "px"
             slider 0…1 "Feather"  bind finish.spot.feather  decimals 2  step 0.05
             slider 0…1 "Opacity"  bind finish.spot.opacity  decimals 2  step 0.05
             row  class "cb-finish-spot-cmds"
               button  run spot.delete  small  text "Delete"
               button  run spot.clear  small  text "Clear all"
             text "Heal and clone are layers of the print (the Re…  dim
           panel finish-layers "Retouch and clarity"
             stack.layers  add [clarity]  filter θ  stage "print"  composite law · + Layer 1 ops
           panel finish-dust "Dust (on the negative)"
             stack.layers  empty "A photo has no negative: dust is healed on a s…  stage "scan"  repair law
           panel layer-params-finish "Layer"
             stack.params  editors {curve, levels, hsl, grade, mixer}
  bottom dockcol  width 124
           filmstrip strip-finish  cell θ  context [frame.reopenAsPhoto, frame.reopenAsNegative, -…  empty "No photos yet: File ▸ Open Files… (Ctrl+O), or…  items τ  key θ  keys {Delete, Backspace}  select ui.selection
