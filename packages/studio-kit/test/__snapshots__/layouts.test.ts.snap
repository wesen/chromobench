                         spacer
                       row  class "cb-ring-density"
                         column  class "cb-ring-tile"
                           thumb  image τ
                           button "−2 step"  run ring.apply([-0.2, -0.2, -0…, "Ring-around −2…)  small
                         column  class "cb-ring-tile"
                           thumb  image τ
                           button "−1 step"  run ring.apply([-0.1, -0.1, -0…, "Ring-around −1…)  small
                         column  class "cb-ring-tile"
                           thumb  image τ
                           button "+1 step"  run ring.apply([0.1, 0.1, 0.1], "Ring-around +1…)  small
                         column  class "cb-ring-tile"
                           thumb  image τ
                           button "+2 step"  run ring.apply([0.2, 0.2, 0.2], "Ring-around +2…)  small
               column  class "cb-simple-side"  width 320
                 cb.arg  labels [Lighter, Darker]  path "main.params.time_s"  step "1/3 st"  widget "nudge"  nudge  s  log2  step 1/3 st  aside st
                 cb.arg  axis "yellow-blue"  labels [Warmer, Cooler]  path "lights.params.logH"  step "2 pt"  widget "nudge"  nudge  pt  step 2 pt  aside log H  detent 0
                 cb.arg  axis "magenta-green"  labels [Greener, More magenta]  path "lights.params.logH"  step "2 pt"  widget "nudge"  nudge  pt  step 2 pt  aside log H  detent 0
                 cb.arg  labels [Softer, Harder]  path "stages.darkroom.medium.grade"  step 0.5  widget "nudge"  nudge  step 0.5
                 button  primary  run tool.ring-around  text "Which looks best?"
                 cb.approvals  compact
           cases.save:
             panel output "Save"
               cb.output  simple
