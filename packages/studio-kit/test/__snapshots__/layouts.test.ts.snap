exports[`layouts build headless > simple: zero errors, explain snapshot 1`] = `
"shell "Chromobench" · theme craftkit · kits: cb.core@1, cb.stack@1 (requires cb.core), cb.diagnostics@1 (requires cb.core), cb.select@1 (requires cb.core)
module main "Chromobench" stages darkroom
  top    cb.steps  labels {pick, print, save}  steps [pick, print, save]
  center match  of [pick, print, save]  on τ
           cases.pick:
             gridview pick-grid  cell θ  context [frame.reopenAsPhoto, frame.reopenAsNegative, -…  empty "No photos yet: File ▸ Open Files… (Ctrl+O), or…  items τ  key θ  keys {Delete, Backspace, P, X, Enter}  select ui.selection  size τ
           cases.print:
             row  grow 1
               column  class "cb-viewer"  grow 1
                 cb.ribbon
                 match  of [view, ring]  on τ
                   cases.view:
                     viewport main τ  cover τ  image τ  overlays:   tools []
                   cases.ring:
                     column  class "cb-ring"  grow 1
                       text "Ring-around, 4 pt: click the print that looks …  strong
                       grid  class "cb-ring-grid"  cols 3
                         column  class "cb-ring-tile"
                           thumb  image τ
                           button "+Y (−B)"  run ring.apply([-0.05, -0.05, …, "Ring-around +Y…)  small
                         column  class "cb-ring-tile"
                           thumb  image τ
                           button "+R (−C)"  run ring.apply([-0.1, 0.05, 0.…, "Ring-around +R…)  small
                         column  class "cb-ring-tile"
                           thumb  image τ
                           button "+M (−G)"  run ring.apply([-0.05, 0.1, -0…, "Ring-around +M…)  small
                         column  class "cb-ring-tile"
                           thumb  image τ
                           button "+G (−M)"  run ring.apply([0.05, -0.1, 0.…, "Ring-around +G…)  small
                         column  class "cb-ring-tile is-current"
                           thumb  image τ
                           button  run tool.none  small  text "Keep this one"
                         column  class "cb-ring-tile"
                           thumb  image τ
                           button "+B (−Y)"  run ring.apply([0.05, 0.05, -0…, "Ring-around +B…)  small
                         spacer
                         column  class "cb-ring-tile"
                           thumb  image τ
