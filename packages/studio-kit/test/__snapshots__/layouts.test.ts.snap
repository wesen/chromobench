exports[`layouts build headless > darkroom: zero errors, explain snapshot 1`] = `
"shell "Chromobench" · theme craftkit · kits: cb.core@1, cb.stack@1 (requires cb.core), cb.diagnostics@1 (requires cb.core), cb.select@1 (requires cb.core), cb.looks@1 (requires cb.core)
module main "Darkroom" stages darkroom, print
  left   dockcol  width 200
           listview strip-v  context [frame.reopenAsPhoto, frame.reopenAsNegative, -…  empty "No photos yet: File ▸ Open Files… (Ctrl+O), or…  items τ  key θ  keys {Delete, Backspace}  row θ  rowHeight 150  select ui.selection
           panel history "History"  hidden τ
