                 hud:
                   cb.readout
             cases.ring:
               cb.ring
  right  dockcol  width 320
           panel densitometer-lab "Densitometer"
             cb.densitometer
           panel history-lab "History"
             cb.history
           panel approvals-lab "Agent proposals"
             cb.approvals
