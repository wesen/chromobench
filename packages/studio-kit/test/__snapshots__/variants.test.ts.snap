  view.beforeAfter "Before / After" (View) \\ ← cb.core
  view.sideBySide "Side by Side" (View) Y ← cb.core
  step.go "Go to Step" ← cb.core
  history.jump "Jump in History" ← cb.core
  proposal.show "Show Proposal" ← cb.core
  proposal.toggle "Include Change" ← cb.core
  proposal.approve "Approve Agent Change" ← cb.core
  proposal.reject "Reject Agent Change" ← cb.core
  proposal.approveAll "Approve All Agent Changes" (Edit) ← cb.core
  snapshot.new "New Snapshot" (Frame) S ← cb.core
  snapshot.restore "Restore Snapshot" ← cb.core
  print.applyToSelection "Apply Print Settings to Selection" (Frame) ← cb.core
  probe.pin "Pin Probe" (Frame) P ← cb.core
  ring.apply "Use This Print" ← cb.core
  exposure.add "Add Exposure" (Frame) ← cb.core
  exposure.remove "Remove Exposure" ← cb.core
  agent.mode "Agent Mode" ← cb.core
