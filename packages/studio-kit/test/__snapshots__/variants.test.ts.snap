exports[`variants build headless > simple: zero errors, explain snapshot 1`] = `
"shell "Chromobench" · theme chromogen · kits: cb.core@1
module main "Chromobench"
  top    cb.steps  labels {pick, print, save}  steps [pick, print, save]
  center match  of [pick, print, save]  on τ
           cases.pick:
             gridview pick-grid  cell θ  empty "No frames yet: open a negative"  items τ  key θ  keys {P, X, Enter}  select ui.selection  size τ
           cases.print:
             row  grow 1
               column  class "cb-viewer"  grow 1
                 cb.ribbon
                 match  of [view, ring]  on τ
                   cases.view:
                     viewport main τ  image τ  overlays:   tools []
                   cases.ring:
                     cb.ring
               column  class "cb-simple-side"  width 320
                 cb.arg  labels [Lighter, Darker]  path "print.enlarger.time_s"  step "1/3 st"  widget "nudge"  nudge  s  log2  step 1/3 st  aside st
                 cb.arg  axis "yellow-blue"  labels [Warmer, Cooler]  path "print.lights.logH"  step "2 pt"  widget "nudge"  nudge  pt  step 2 pt  aside log H  detent 0
                 cb.arg  axis "magenta-green"  labels [Greener, More magenta]  path "print.lights.logH"  step "2 pt"  widget "nudge"  nudge  pt  step 2 pt  aside log H  detent 0
                 cb.arg  labels [Softer, Harder]  path "print.grade"  step 0.5  widget "nudge"  nudge  step 0.5
                 button  primary  run tool.ring-around  text "Which looks best?"
                 cb.approvals  compact
           cases.save:
             panel output "Save"
               cb.output  simple
commands
  frame.pick "Flag as Pick" (Frame) P ← cb.core
  frame.reject "Reject" (Frame) X ← cb.core
  frame.unflag "Unflag" (Frame) ← cb.core
  frame.rate "Set Stars" (Frame) ← cb.core
  frame.label "Set Colour Label" ← cb.core
  frame.select "Select Frame" ← cb.core
  frame.next "Next Frame" (Frame) ← cb.core
  frame.previous "Previous Frame" (Frame) ← cb.core
  view.mode "Library View" ← cb.core
  view.show "Show View" ← cb.core
  view.beforeAfter "Before / After" (View) ← cb.core
  view.sideBySide "Side by Side" (View) ← cb.core
  step.go "Go to Step" ← cb.core
  history.jump "Jump in History" ← cb.core
  proposal.show "Show Proposal" ← cb.core
  proposal.toggle "Include Change" ← cb.core
  proposal.approve "Approve Agent Change" ← cb.core
  proposal.reject "Reject Agent Change" ← cb.core
  proposal.approveAll "Approve All Agent Changes" (Edit) ← cb.core
  snapshot.new "New Snapshot" (Frame) ← cb.core
  snapshot.restore "Restore Snapshot" ← cb.core
  print.applyToSelection "Apply Print Settings to Selection" (Frame) ← cb.core
  probe.pin "Pin Probe" (Frame) ← cb.core
  ring.apply "Use This Print" ← cb.core
  exposure.add "Add Exposure" (Frame) ← cb.core
  exposure.remove "Remove Exposure" ← cb.core
  agent.mode "Agent Mode" ← cb.core
  output.save "Save the Print" (File) ← cb.core
tools probe (I), test-strip (T), ring-around (R), mask-ellipse (M), mask-gradient, mask-brush
commands 57 · keys 22 in 3 scopes · tools 6 · passes 14 · diagnostics ✓ 0 errors · 0 warnings"
