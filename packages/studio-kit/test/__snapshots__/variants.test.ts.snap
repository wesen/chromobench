// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`variants build headless > classic: zero errors, explain snapshot 1`] = `
"shell "Chromobench" · theme chromogen · kits: cb.core@1
module library "Library" key G
  left   dockcol  width 236
           panel navigator "Navigator"
             thumb  image τ
             text τ  dim
           panel library "Library"
             cb.library
  center column  grow 1
           cb.filter
           match  of [grid, loupe, compare, survey]  on τ
             cases.grid:
               gridview grid  cell θ  empty "No frames yet: open a negative"  items τ  key θ  select ui.selection  size τ
             cases.loupe:
               column  class "cb-viewer"  grow 1
                 cb.ribbon
                 viewport loupe τ  image τ  overlays: 
             cases.compare:
               row  grow 1
                 column  class "cb-viewer"  grow 1
                   cb.ribbon
                   viewport cmp-a τ  image τ  overlays: 
                 column  class "cb-viewer"  grow 1
                   cb.ribbon
                   viewport cmp-b τ  image τ  overlays: 
             cases.survey:
               gridview survey  cell θ  empty "No frames yet: open a negative"  items τ  key θ  select ui.selection  size τ
  right  dockcol  width 260
           panel metadata "Metadata"
             cb.metadata
  bottom filmstrip strip  cell θ  empty "Open a negative (File ▸ Open, or drop a TIFF)"  items τ  key θ  select ui.selection
module print "Print" key D
  left   dockcol  width 236
           panel navigator-print "Navigator"
             thumb  image τ
             text τ  dim
           panel snapshots "Snapshots"
             cb.snapshots
           panel history "History"
             cb.history
  center column  class "cb-viewer"  grow 1
           segmented "View"  bind view.view  options [{…}, {…}, {…}, {…}]  small
           cb.ribbon
           match  of [view, ring]  on τ
             cases.view:
               viewport main τ  before τ  compare  image τ  overlays:   tools [probe, test-strip, mask-ellipse, mask-gradient…
                 hud:
                   cb.readout
             cases.ring:
               cb.ring
  right  dockcol  width 300
           panel densitometer "Densitometer"
             cb.densitometer
           panel controls-darkroom "Darkroom"
             section "Exposure"
               cb.arg  path "print.enlarger.time_s"  slider  s  log2  step 1/6 st  aside st
               cb.arg  path "print.enlarger.fstop"  stepper  f  log2  aside st
             section "Filtration"
               cb.arg  path "print.enlarger.filtration"  slider  CC  step 1 CC  aside pt  detent 0
             section "Printer lights"
               cb.arg  path "print.lights.logH"  widget "pad"  pad  pt  step 1 pt  aside log H  detent 0
             section "Paper"
               cb.arg  path "print.paper"  select
               cb.arg  path "print.grade"  slider  step 0.5 none
               cb.arg  path "print.preflash"  slider  fraction  step 0.005 fraction
           panel exposures "Exposures"
             cb.exposures
           panel approvals "Agent proposals"
             cb.approvals
  bottom filmstrip strip-print  cell θ  empty "Open a negative (File ▸ Open, or drop a TIFF)"  items τ  key θ  select ui.selection
module output "Output" key Mod+Shift+E
  center gridview picks  cell θ  empty "No frames yet: open a negative"  items τ  key θ  select ui.selection  size τ
  right  dockcol  width 260
           panel output "Save"
             cb.output
  bottom filmstrip strip-output  cell θ  empty "Open a negative (File ▸ Open, or drop a TIFF)"  items τ  key θ  select ui.selection
commands
  frame.pick "Flag as Pick" (Frame) P ← cb.core
  frame.reject "Reject" (Frame) X ← cb.core
  frame.unflag "Unflag" (Frame) U ← cb.core
  frame.rate "Set Stars" (Frame) ← cb.core
  frame.label "Set Colour Label" ← cb.core
  frame.select "Select Frame" ← cb.core
  frame.next "Next Frame" (Frame) → ← cb.core
  frame.previous "Previous Frame" (Frame) ← ← cb.core
  view.mode "Library View" ← cb.core
  view.show "Show View" ← cb.core
  view.beforeAfter "Before / After" (View) \\ ← cb.core
  view.sideBySide "Side by Side" (View) Y ← cb.core
  step.go "Go to Step" ← cb.core
  history.jump "Jump in History" ← cb.core
  proposal.show "Show Proposal" ← cb.core
  proposal.toggle "Include Change" ← cb.core
  proposal.approve "Approve Agent Change" ← cb.core
  proposal.reject "Reject Agent Change" ← cb.core
  proposal.approveAll "Approve All Agent Changes" (Edit) ← cb.core
  snapshot.new "New Snapshot" (Frame) S ← cb.core
  snapshot.restore "Restore Snapshot" ← cb.core
  print.applyToSelection "Apply Print Settings to Selection" (Frame) ← cb.core
  probe.pin "Pin Probe" (Frame) P ← cb.core
  ring.apply "Use This Print" ← cb.core
  exposure.add "Add Exposure" (Frame) ← cb.core
  exposure.remove "Remove Exposure" ← cb.core
  agent.mode "Agent Mode" ← cb.core
  output.save "Save the Print" (File) ← cb.core
tools probe (I), test-strip (T), ring-around (R), mask-ellipse (M), mask-gradient, mask-brush
commands 60 · keys 51 in 4 scopes · tools 6 · passes 14 · diagnostics ✓ 0 errors · 0 warnings"
`;

exports[`variants build headless > darkroom: zero errors, explain snapshot 1`] = `
"shell "Chromobench" · theme chromogen · kits: cb.core@1
module main "Chromobench"
  left   dockcol  width 200
           listview strip-v  empty "Open a negative (File ▸ Open, or drop a TIFF)"  items τ  key θ  row θ  select ui.selection
           panel history "History"
             cb.history
  center column  class "cb-viewer"  grow 1
           cb.ribbon
           match  of [view, ring]  on τ
             cases.view:
               viewport main τ  before τ  compare  image τ  overlays:   tools [probe, test-strip, mask-brush, mask-gradient]
                 hud:
                   cb.readout
             cases.ring:
               cb.ring
  right  dockcol  width 300
           panel enlarger "Enlarger"
             cb.arg  path "print.enlarger.time_s"  strip {step}  slider  s  log2  step 1/6 st  aside st  +testStrip(1/3 st)
             cb.arg  path "print.enlarger.fstop"  stepper  f  log2  aside st
             cb.arg  path "print.enlarger.filtration"  slider  CC  step 1 CC  aside pt  detent 0
             cb.arg  path "print.lights.logH"  widget "pad"  pad  pt  step 1 pt  aside log H  detent 0
           panel paper "Paper"
             cb.arg  path "print.paper"  select
             cb.arg  path "print.grade"  slider  step 0.5 none
           panel exposures "Exposures"
             cb.exposures
           panel approvals "Agent proposals"
             cb.approvals
commands
  frame.pick "Flag as Pick" (Frame) ← cb.core
  frame.reject "Reject" (Frame) ← cb.core
  frame.unflag "Unflag" (Frame) ← cb.core
  frame.rate "Set Stars" (Frame) ← cb.core
