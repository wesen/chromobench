  bottom filmstrip strip  cell θ  empty "Open a negative (File ▸ Open, or drop a TIFF)"  items τ  key θ  select ui.selection
module print "Print" key D
  left   dockcol  width 236
           panel navigator-print "Navigator"
             thumb  image τ
             text τ  dim
           panel snapshots "Snapshots"
             cb.snapshots
           panel history "History"
             cb.history
  center column  class "cb-viewer"  grow 1
           segmented "View"  bind view.view  options [{…}, {…}, {…}, {…}]  small
           cb.ribbon
           match  of [view, ring]  on τ
             cases.view:
               viewport main τ  before τ  compare  image τ  overlays:   tools [probe, test-strip, mask-ellipse, mask-gradient…
                 hud:
                   cb.readout
             cases.ring:
               cb.ring
  right  dockcol  width 300
           panel densitometer "Densitometer"
             cb.densitometer
           panel controls-darkroom "Darkroom"
             section "Exposure"
               cb.arg  path "print.enlarger.time_s"  slider  s  log2  step 1/6 st  aside st
               cb.arg  path "print.enlarger.fstop"  stepper  f  log2  aside st
             section "Filtration"
               cb.arg  path "print.enlarger.filtration"  slider  CC  step 1 CC  aside pt  detent 0
             section "Printer lights"
               cb.arg  path "print.lights.logH"  widget "pad"  pad  pt  step 1 pt  aside log H  detent 0
             section "Paper"
               cb.arg  path "print.paper"  select
               cb.arg  path "print.grade"  slider  step 0.5 none
               cb.arg  path "print.preflash"  slider  fraction  step 0.005 fraction
           panel exposures "Exposures"
             cb.exposures
           panel approvals "Agent proposals"
             cb.approvals
           panel why "Why"
             cb.why
  bottom filmstrip strip-print  cell θ  empty "Open a negative (File ▸ Open, or drop a TIFF)"  items τ  key θ  select ui.selection
module lab "Lab" key L
  left   dockcol  width 280
           panel controls-all "All parameters"
             section "Capture"
               cb.arg  path "capture.stock"  select
               cb.arg  path "capture.exposureEV"  slider  st  step 0.333 st
               cb.arg  path "capture.whiteBalance.mode"  segmented
               cb.arg  path "capture.whiteBalance.temperature_K"  slider  K  step 50 K
               cb.arg  path "capture.whiteBalance.tint"  slider  step 1 none
             section "Film"
               cb.arg  path "capture.development.dir.amount"  slider  fraction  step 0.05 fraction
               cb.arg  path "capture.development.dir.diffusion_um"  slider  um  step 1 um
               cb.arg  path "capture.development.push"  stepper  st  step 1 st
               cb.arg  path "capture.development.grain.amount"  slider  fraction  step 0.05 fraction
               cb.arg  path "capture.development.grain.size_um"  slider  um  step 0.5 um
               cb.arg  path "capture.development.halation.strength"  slider  fraction  step 0.05 fraction
             section "Finishing"
               cb.arg  path "finishing.values.clarity"  slider  fraction  step 0.01 fraction
             section "Scan"
               cb.arg  path "scan.stock"  select
               cb.arg  path "scan.scanner"  select
               cb.arg  path "scan.flare"  slider  percent  step 0.05 percent
             section "Output"
               cb.arg  path "view.output.rendering"  segmented
             section "Frame"
               cb.arg  path "scan.orientation"  select
             section "Print"
               cb.arg  path "print.grade"  slider  step 0.5 none
               cb.arg  path "print.paper"  select
               cb.arg  path "print.enlarger.mode"  segmented
               cb.arg  path "print.enlarger.filtration"  slider  CC  step 1 CC  aside pt  detent 0
               cb.arg  path "print.enlarger.time_s"  slider  s  log2  step 1/6 st  aside st
               cb.arg  path "print.enlarger.fstop"  stepper  f  log2  aside st
               cb.arg  path "print.lights.logH"  widget "pad"  pad  pt  step 1 pt  aside log H  detent 0
               cb.arg  path "print.preflash"  slider  fraction  step 0.005 fraction
             section "Source"
               cb.arg  path "source.decode.encoding"  segmented
             section "View"
               cb.arg  path "view.flare"  slider  percent  step 0.01 percent
               cb.arg  path "view.illuminant"  select
  center column  class "cb-viewer"  grow 1
           segmented "View"  bind view.view  options [{…}, {…}, {…}, {…}]  small
           cb.ribbon
           match  of [view, ring]  on τ
             cases.view:
