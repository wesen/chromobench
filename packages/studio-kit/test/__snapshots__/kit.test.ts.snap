// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`cb.arg > controls("darkroom") explains as sections of generated controls (snapshot) 1`] = `
"panel controls-darkroom "Darkroom"
  when  cond τ
    else:
      text "Select a photo to print it."  class "cb-empty"  dim
    then:
      column
        section "Exposure"
          text τ  class "cb-group-note"  dim
          cb.arg  path "print.enlarger.mode"
          cb.arg  path "print.enlarger.time_s"
          cb.arg  path "print.enlarger.fstop"
        section "Filtration"
          cb.arg  path "print.enlarger.filtration"
        section "Printer lights"
          cb.arg  path "print.lights.logH"  widget "pad"
        section "Paper"
          cb.arg  path "print.paper"
          cb.arg  path "print.grade"
          cb.arg  path "print.preflash"
        section "Film and viewing"
          text τ  class "cb-group-note"  dim
          cb.arg  path "capture.stock"
          cb.arg  path "scan.stock"
          cb.arg  path "scan.scanner"
          cb.arg  path "view.illuminant""
`;
