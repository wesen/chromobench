  "engine": {
    "id": "reference",
    "adapter": "reference-f64",
    "conventions": "core-v1:opaque/cie1931-2deg/subtract/model-3cdf/midgray-geomean",
    "mode": "exact",
    "wrapper": "StudioEngine (apps/studio/src/host/studio-engine.ts): output.frame"
  },
  "cuts": {
    "print": "the view.adapt node (print-xyz)",
    "display": "the output.frame node (display-rgb, sRGB)"
